    </suppress>
    <suppress until="2026-08-15Z">
        <notes><![CDATA[
            reason=CVE affects Kotlin build-cache metadata deserialization rather than runtime stdlib or reflect JARs; Gradle build cache remains disabled until Kotlin 2.4.20 GA; owner=backend; expires=2026-08-15
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-(?:stdlib|reflect)@2\.0\.20$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>
    <suppress until="2026-10-15Z">
        <notes><![CDATA[
            reason=Reactor Netty 1.2.18 was misidentified as Netty 1.2.18 while the runtime uses patched Netty 4.1.136.Final; owner=backend; expires=2026-10-15
        ]]></notes>
        <filePath regex="true">.*io\.projectreactor\.netty__reactor-netty-(core|http)__1\.2\.18__reactor-netty-\1-1\.2\.18\.jar$</filePath>
        <cpe>cpe:/a:netty:netty</cpe>
