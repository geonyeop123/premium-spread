    <suppress until="2026-10-15Z">
        <notes><![CDATA[
            reason=CVE applies to the Prometheus server /api/v1/read implementation, not the Java metrics client JAR; owner=backend; expires=2026-10-15
        ]]></notes>
        <filePath regex="true">.*(?:io\.micrometer__micrometer-registry-prometheus__1\.15\.12__micrometer-registry-prometheus-1\.15\.12\.jar|io\.prometheus__prometheus-metrics-(config|core|exposition-formats|exposition-textformats|model|tracer-common)__1\.3\.10__prometheus-metrics-\1-1\.3\.10\.jar)$</filePath>
