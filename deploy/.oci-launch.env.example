# OCI 인스턴스 자동 생성 재시도 설정 (Out of host capacity 대응)
# 사용:  cp deploy/.oci-launch.env.example .oci-launch.env   → OCID 채우기 → ./deploy/launch-retry.sh
# 이 파일을 복사한 .oci-launch.env 는 .gitignore 처리됨 (OCID/키 경로가 git에 안 올라감)

# ── 필수: OCID 5개 (아래 '수집 방법' 참고) ──
COMPARTMENT_OCID=ocid1.tenancy.oc1..xxxx        # 보통 tenancy 루트 OCID 그대로 사용
AD_NAME=xxxx:AP-CHUNCHEON-1-AD-1                # availability domain '이름' (OCID 아님)
SUBNET_OCID=ocid1.subnet.oc1..xxxx              # ★ public subnet (private 아님)
IMAGE_OCID=ocid1.image.oc1..xxxx               # Ubuntu 22.04 aarch64 이미지
SSH_PUBKEY_PATH=$HOME/.ssh/oracle_premium.pub   # 1-A에서 만든 공개키 (~ 대신 $HOME)

# ── 선택: 스펙 / 재시도 동작 ──
DISPLAY_NAME=premium-spread
OCPUS=1
MEM_GB=6
BOOT_VOLUME_GB=50
RETRY_INTERVAL=60        # 재시도 간격(초). 너무 짧으면 429(rate limit) 유발
MAX_ATTEMPTS=0           # 0 = 무한 재시도 (Ctrl-C로 중단)

# ────────────────────────────────────────────────────────────
# OCID 수집 방법 (OCI CLI 설치 + 인증 후 1회만)
#
# 0) 설치:
#    bash -c "$(curl -L https://raw.githubusercontent.com/oracle/oci-cli/master/scripts/install/install.sh)"
# 1) 인증:
#    oci setup config
#    (Tenancy OCID / User OCID / region 입력 → API 키 생성 → 콘솔 Identity>Users>본인>API Keys에 공개키 등록)
#    → 이후 편의상:   C=<COMPARTMENT_OCID>   (tenancy OCID 그대로 써도 됨)
#
# 2) AD 이름:
#    oci iam availability-domain list --compartment-id "$C" --query 'data[].name' --raw-output
#
# 3) VCN 목록 (만들어 둔 VCN의 id 확인):
#    oci network vcn list --compartment-id "$C" \
#      --query 'data[].{name:"display-name", id:id}' --output table
#
# 4) public subnet 찾기  (private 컬럼이 false 인 것이 public):
#    oci network subnet list --compartment-id "$C" --vcn-id <VCN_OCID> \
#      --query 'data[].{name:"display-name", private:"prohibit-public-ip-on-vnic", id:id}' --output table
#
# 5) Ubuntu 22.04 ARM 이미지 OCID:
#    oci compute image list --compartment-id "$C" \
#      --operating-system "Canonical Ubuntu" --operating-system-version "22.04" \
#      --shape VM.Standard.A1.Flex --query 'data[0].id' --raw-output
