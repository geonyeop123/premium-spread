# Premium Spread — 운영(Oracle Cloud 단일 호스트) 환경변수 템플릿
# 사용: 레포 루트에서  cp deploy/.env.prd.example .env  후 값 채우기
# (docker compose는 실행 디렉터리의 .env를 자동 로드 → 반드시 레포 루트에 .env 위치)
#
# 단일 호스트 compose 토폴로지에서는 *_HOST 류는 compose가 서비스명으로 override 한다.
# 즉 MYSQL_HOST/REDIS_*_HOST 값은 이 배포 방식에선 무시되므로 그대로 둬도 된다.
# 실제로 효력 있는 값은 ★ 표시.

# ── DB 인증 (★ infra-compose 초기화 + 앱 접속에 동시 사용 — 두 곳이 같은 소스) ──
# 최초 부팅 시 MySQL 데이터 볼륨이 비어 있어야 이 값으로 계정이 생성된다.
MYSQL_ROOT_PASSWORD=change-me-strong-root-pw   # ★
MYSQL_USER=application                          # ★ (앱 datasource username)
MYSQL_PWD=change-me-strong-app-pw               # ★ (앱 datasource password)
MYSQL_DATABASE=premiumspread                    # JDBC URL이 premiumspread 고정이므로 변경 금지

# compose가 mysql 서비스명으로 override → 단일 호스트에선 미사용
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ── Redis 인증 (★ infra-compose requirepass/masterauth + 앱 접속에 동시 사용) ──
REDIS_PASSWORD=change-me-strong-redis-pw        # ★ 반드시 app/infra 동일 (불일치 시 인증 실패)

# compose가 redis-master / redis-readonly 서비스명으로 override → 단일 호스트에선 미사용
REDIS_MASTER_HOST=redis-master
REDIS_MASTER_PORT=6379
REDIS_REPLICA_1_HOST=redis-readonly
REDIS_REPLICA_1_PORT=6379

# ── Batch: ExchangeRate API (★) ──────────────────────────
# https://exchangerate-api.com 에서 발급
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here   # ★

# ── Batch: 이메일 알림 (★ batch만 사용) ───────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com              # ★
MAIL_PASSWORD=your-gmail-app-password           # ★ (Gmail 앱 비밀번호)
ALERT_EMAIL_FROM=your-gmail@gmail.com           # ★

# ── 알림: Slack (선택, 미설정 시 비활성) ──────────────────
SLACK_WEBHOOK_URL=

# ── 컨테이너 메모리 한도 (선택, 박스 스펙에 맞춰 조절) ────────
# 기본값(6GB 박스 기준): api 1536m / batch 1536m / web 512m
# 24GB로 확장하면 API_MEM_LIMIT=3072m 등으로 상향
API_MEM_LIMIT=1536m
BATCH_MEM_LIMIT=1536m
WEB_MEM_LIMIT=512m
