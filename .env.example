# Premium Spread — local 개발용 환경변수 예시
# 실제 운영 secret은 이 파일이나 서버 .env에 저장하지 않고 GitHub production
# Environment secret 또는 조직 secret manager에서만 주입합니다.

# ── Batch: ExchangeRate API ──────────────────────────────
# https://exchangerate-api.com 에서 발급
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here

# ── Redis Authentication ─────────────────────────────────
# Production Redis requirepass 설정값과 일치해야 함
REDIS_PASSWORD=your-redis-password-here

# ── MySQL (Production) ───────────────────────────────────
MYSQL_HOST=your-mysql-host
MYSQL_USER=your-mysql-user
MYSQL_PWD=your-mysql-password

# ── API JWT (local/test 외 필수) ─────────────────────────
# REPLACE_ME 상태로는 API가 기동되지 않는다. 32 byte 이상의 임의 secret으로 교체한다.
JWT_SECRET_KEY=REPLACE_ME
JWT_ISSUER=premium-spread
JWT_AUDIENCE=premium-spread-api
JWT_ACCESS_TOKEN_EXPIRY_MS=1800000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
JWT_CLOCK_SKEW_SECONDS=30
AUTH_REFRESH_HMAC_KEY=REPLACE_ME
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Runtime pool / management tuning (optional) ────────────────────────
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_VALIDATION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE_MS=0
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_LEAK_DETECTION_MS=0
DB_POOL_INITIALIZATION_FAIL_TIMEOUT_MS=1
REDIS_POOL_SIZE=10
REDIS_POOL_MIN_IDLE=2
REDIS_RETRY_ATTEMPTS=3
REDIS_RETRY_INTERVAL=1500ms
REDIS_COMMAND_TIMEOUT=3s
REDIS_CONNECT_TIMEOUT=10s
# Docker가 아닌 local 실행은 loopback이 기본값입니다.
MANAGEMENT_ADDRESS=127.0.0.1

# 파일에는 false로 유지. 승인된 한 번의 실행에만 process env로 true를 전달한다.
MIGRATION_V12_ALLOW_EMPTY=false

# ── Redis Connection (Production) ────────────────────────
REDIS_MASTER_HOST=your-redis-host
REDIS_MASTER_PORT=6379

# ── Email (사용자 알림, batch만 필요) ──────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
ALERT_EMAIL_FROM=your-gmail@gmail.com
NOTIFICATION_EMAIL_ENABLED=false
